{
  "name": "paper-insight",
  "version": "1.0.0",
  "private": true,
  "description": "AI论文智析 - 上传论文自动解析要点、生成PPT、AI智能问答（全平台可用）",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development nest start --watch",
    "dev:client": "NODE_ENV=development vite --config vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "NODE_ENV=production nest build",
    "build:client": "NODE_ENV=production vite build --config vite.config.ts",
    "start": "NODE_ENV=production node dist/server/main.js",
    "db:push": "ts-node scripts/db-push.ts",
    "type:check": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run type:check:server\" \"npm run type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/serve-static": "^4.0.0",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.15",
    "drizzle-orm": "^0.44.6",
    "hbs": "^4.2.0",
    "lucide-react": "^0.554.0",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.90.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.7",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sonner": "^2.0.7",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0",
    "clsx": "~2.0.1",
    "tailwind-merge": "~3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.1"
  }
}
